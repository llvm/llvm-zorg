#!/bin/bash
# Starts a bazel build matching buildkite config.
# Arguments are passed to `bazel build` verbatim (flags and/or targets).
set -ueo pipefail

# Those variables have to match automated buildkite bazel agent runner to share
# remote cache.
export PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin:/usr/bin
export BAZELISK_HOME=/var/lib/buildkite-agent/.cache/bazelisk

# Differences from build script running on buildkite (https://buildkite.com/llvm-project/upstream-bazel/settings/steps):
# 1. Quiet mode is important so it doesn't populate LLM logs with unnecessary info
# 2. --lockfile_mode=off for both query and build to avoid updating MODULE.bazel.lock files
# 3. --nokeep_going so we don't pollute agent's context with too many failures.
bazelisk --quiet ${BAZEL_OUTPUT_BASE:+--output_base="$BAZEL_OUTPUT_BASE"} \
  build --lockfile_mode=off --config=ci --jobs=128 --nokeep_going \
  --sandbox_base='' --remote_cache=https://storage.googleapis.com/llvm-bazel-cache \
  --google_default_credentials \
  "$@"
