#!/bin/bash
# Starts a bazel build matching buildkite config.
# Arguments are passed to `bazel build` verbatim (flags and/or targets).
set -ueo pipefail

# Quiet mode is important so it doesn't populate LLM logs with unnecessary info
bazelisk --quiet ${BAZEL_OUTPUT_BASE:+--output_base="$BAZEL_OUTPUT_BASE"} \
  build --lockfile_mode=off --config=generic_clang --jobs=128 \
  --build_tag_filters=-nobuildkite \
  --test_tag_filters=-nobuildkite \
  --remote_cache=https://storage.googleapis.com/llvm-bazel-cache \
  --google_default_credentials \
  "$@"
