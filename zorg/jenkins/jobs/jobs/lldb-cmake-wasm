#!/usr/bin/env groovy

pipeline {
    options {
        disableConcurrentBuilds()
    }

    parameters {
        string(name: 'LABEL', defaultValue: params.LABEL ?: 'macos-arm64', description: 'Node label to run on')

        string(name: 'GIT_SHA', defaultValue: params.GIT_REVISION ?: '*/main', description: 'Git commit to build.')

        string(name: 'BUILD_TYPE', defaultValue: params.BUILD_TYPE ?: 'Release', description: 'Default CMake build type; one of: Release, Debug, ...')

        booleanParam(name: 'CLEAN', defaultValue: params.CLEAN ?: false, description: 'Wipe the build directory?')
    }

    agent {
        node {
            label params.LABEL
        }
    }
    environment {
        PATH="$PATH:/usr/bin:/usr/local/bin"
        // The swift.org build that provides the Wasm SDK and the WasmKit runtime.
        // WasmKit before 0.4.0 rejects the empty environment values LLDB forwards.
        SWIFT_DOWNLOADS = 'https://download.swift.org/development'
        SWIFT_BUILD = 'swift-DEVELOPMENT-SNAPSHOT-2026-11-01-a'
        SWIFT_WASM_SDK_SHA256 = '66293bcf3599e2525376c6be195dbacfb4729df9ef5ab3cd6fd260d787a184e4'
        SWIFT_TOOLCHAIN_SHA256 = '9582e21a1a7096f578fd1f616be8e8588259b516ce58885bac70eb345e3c49b6'
    }
    stages {
        stage('Print Machine Info') {
            steps {
                sh '''
                arch
                sw_vers
                xcodebuild -version
                cmake --version
                python3 --version
                '''
            }
        }
        stage('Checkout') {
            steps {
                timeout(30) {
                    dir('llvm-project') {
                        checkout([$class: 'GitSCM', branches: [
                            [name: params.GIT_SHA]
                        ], userRemoteConfigs: [
                            [url: 'https://github.com/llvm/llvm-project.git']
                        ], extensions: [
                            [$class: 'CloneOption',
                            noTags: true, timeout: 30]
                        ]])
                    }
                    dir('llvm-zorg') {
                        checkout([$class: 'GitSCM', branches: [
                            [name: '*/main']
                        ], userRemoteConfigs: [
                            [url: 'https://github.com/llvm/llvm-zorg.git']
                        ], extensions: [
                            [$class: 'CloneOption',
                            reference: '/Users/Shared/llvm-zorg.git']
                        ]])
                    }
                }
            }
        }
        stage('Setup Venv') {
            steps {
                sh '''
                   # Non-incremental, so always delete.
                   rm -rf venv
                   rm -rf test/results.xml
                   python3 -m venv venv
                   set +u
                   source ./venv/bin/activate
                   pip install -r ./llvm-zorg/zorg/jenkins/jobs/requirements.txt
                   set -u
               '''
            }
        }
        stage('Fetch Swift Wasm SDK') {
            steps {
                timeout(30) {
                    sh '''
                    rm -rf wasm
                    mkdir wasm
                    cd wasm

                    curl -fsSL -o sdk.tar.gz \
                      "$SWIFT_DOWNLOADS/wasm-sdk/$SWIFT_BUILD/${SWIFT_BUILD}_wasm.artifactbundle.tar.gz"
                    curl -fsSL -o toolchain.pkg \
                      "$SWIFT_DOWNLOADS/xcode/$SWIFT_BUILD/$SWIFT_BUILD-osx.pkg"
                    echo "$SWIFT_WASM_SDK_SHA256  sdk.tar.gz" | shasum -a 256 -c -
                    echo "$SWIFT_TOOLCHAIN_SHA256  toolchain.pkg" | shasum -a 256 -c -

                    tar -xzf sdk.tar.gz
                    pkgutil --expand-full toolchain.pkg toolchain
                    rm sdk.tar.gz toolchain.pkg

                    # A runtime without the GDB stub fails every test the same
                    # way, far from the cause.
                    toolchain/*/Payload/usr/bin/wasmkit run --help | grep -q -- --debugger-port
                    '''
                }
            }
        }
        stage('Build') {
            steps {
                timeout(90) {
                    sh '''
                    set -u
                    source ./venv/bin/activate

                    sdk=$WORKSPACE/wasm/${SWIFT_BUILD}_wasm.artifactbundle/${SWIFT_BUILD}_wasm/wasm32-unknown-wasip1
                    wasmkit=$WORKSPACE/wasm/toolchain/$SWIFT_BUILD-osx-package.pkg/Payload/usr/bin/wasmkit

                    rm -rf lldb-build/bin/debugserver

                    python3 llvm-zorg/zorg/jenkins/monorepo_build.py lldb-cmake build \
                      --cmake-flag="-DLLVM_TARGETS_TO_BUILD=X86;AArch64;WebAssembly" \
                      --assertions \
                      --projects="clang;lld;lldb"  \
                      --runtimes="libcxx;libcxxabi;libunwind"  \
                      --cmake-type=Release \
                      --dotest-flag="--triple" \
                      --dotest-flag="wasm32-wasip1" \
                      --dotest-flag="--platform-name" \
                      --dotest-flag="wasm" \
                      --dotest-flag="--sysroot" \
                      --dotest-flag="$sdk/WASI.sdk" \
                      --dotest-flag="--resource-dir" \
                      --dotest-flag="$sdk/swift.xctoolchain/usr/lib/clang" \
                      --dotest-flag="--setting" \
                      --dotest-flag="platform.plugin.wasm.runtime-path=$wasmkit" \
                      --dotest-flag="--setting" \
                      --dotest-flag="platform.plugin.wasm.runtime-args=run" \
                      --dotest-flag="--setting" \
                      --dotest-flag="platform.plugin.wasm.port-arg=--debugger-port=" \
                      --dotest-flag="--setting" \
                      --dotest-flag="platform.plugin.wasm.env-arg=--env="
                    '''
                    script {
                        def LLDB = new org.swift.LLDB()
                        LLDB.LLDB_prepare()
                    }
                }
            }
        }
        stage('Pre-scan Binaries') {
            environment {
                PATH="$PATH:/usr/bin:/usr/local/bin:/opt/homebrew/bin/"
            }
            steps {
                timeout(60) {
                    // Launch every built binary once so the macOS malware
                    // scan on first launch doesn't happen during the tests.
                    sh '''
                    python3 llvm-zorg/zorg/jenkins/jobs/util/prescan_binaries.py lldb-build/bin
                    '''
                }
            }
        }
        stage('Test') {
            steps {
                timeout(60) {
                    sh '''
                    set -u
                    source ./venv/bin/activate

                    # A test that abandons a running process leaves its runtime
                    # behind: WasmKit cannot be interrupted while the guest runs.
                    trap 'pkill -f "$WORKSPACE/wasm/toolchain" || true' EXIT

                    # Only the API tests build for the configured triple.
                    python3 llvm-zorg/zorg/jenkins/monorepo_build.py lldb-cmake \
                      --cmake-test-target=check-lldb-api
                    '''
                }
            }
        }
    }

    post {
        always {
            script {
                def Junit = new org.swift.Junit()
                Junit.safeJunit([
                    testResults: 'test/results.xml'
                ])
            }
        }
    }
}
